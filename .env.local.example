# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Llave pública. Usa la nueva (recomendado):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# …o la anon key de siempre, si tu proyecto todavía usa el formato viejo:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# NUNCA pongas aquí la secret key (sb_secret_... o service_role):
# se salta el RLS y esto viaja al navegador.
